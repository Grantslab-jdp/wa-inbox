# Set these in Vercel (Production + Preview). Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
WHATSAPP_ACCESS_TOKEN=        # permanent System User token (not the temporary 24h one)
WHATSAPP_APP_SECRET=          # Meta app > App settings > Basic > App secret
WHATSAPP_VERIFY_TOKEN=        # any long random string; paste the same into the Meta webhook settings
WHATSAPP_GRAPH_VERSION=v27.0
